# ==========================================
# BACKEND ENVIRONMENT VARIABLES (Render / Local)
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*

# ==========================================
# FRONTEND ENVIRONMENT VARIABLES (Netlify)
# ==========================================
# Leave empty for local development to use Vite proxy (/api)
# Set to your deployed Render URL for production (e.g. https://social-media-content-analyzer-backend.onrender.com)
VITE_API_URL=
